# Optional Visual Creative Engine client settings for Metrotherapy.
# Merge these values into the authoritative production environment only when
# the separately deployed Visual Creative Gateway is enabled.

# Base URL of the independent gateway. A path prefix is allowed.
VISUAL_GATEWAY_URL=https://visual-gateway.example.internal

# Per-application bearer token issued by the gateway. Never commit a real token.
VISUAL_GATEWAY_TOKEN=

# Deployment country used by the gateway's provider policy (for example RU/NL/US).
VISUAL_DEPLOYMENT_COUNTRY=RU

# How long Telegram commands may wait synchronously before returning a job id.
# Accepted by the client: 0..60 seconds.
VISUAL_TELEGRAM_WAIT_SECONDS=20

# Transport and response limits. These protect the bot process from a broken or
# malicious gateway response; they do not replace gateway-side quotas.
VISUAL_GATEWAY_TIMEOUT_SECONDS=30
VISUAL_GATEWAY_MAX_JSON_BYTES=1048576
VISUAL_GATEWAY_MAX_MEDIA_BYTES=268435456

# Temporary download location. Files are removed after Telegram upload.
VISUAL_CREATIVE_OUTPUT_DIR=data/visual_creatives
